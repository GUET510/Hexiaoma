page {
  --primary-color: #39b54a;
  --primary-color-dark: #2da040;
  --text-main: #1f2f3d;
  --text-secondary: #6c7a89;
  --card-bg: #fff;
  --border-subtle: #e6ecf2;
  --muted-bg: #f6f7fb;
  background: var(--muted-bg);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.section {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.badge {
  font-size: 20rpx;
  color: var(--primary-color);
  background: #e8f7ed;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.primary-btn {
  background: linear-gradient(90deg, var(--primary-color), var(--primary-color-dark));
  color: #fff;
  border: none;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  margin-top: 12rpx;
}

.ghost-btn {
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
  border-radius: 12rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  background: transparent;
}

.info-text {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.qr-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 2rpx dashed #d0d8e0;
  border-radius: 12rpx;
  min-height: 280rpx;
  background: #fbfcff;
}

.qr-tip {
  color: var(--text-secondary);
  font-size: 26rpx;
  text-align: center;
}

.qr-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240rpx, 1fr));
  gap: 20rpx;
  width: 100%;
}

.qr-card {
  background: #f8fafc;
  border: 2rpx solid var(--border-subtle);
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.qr-visual {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-amount {
  font-size: 24rpx;
  color: #2f5af5;
}

.qr-canvas {
  width: 240rpx;
  height: 240rpx;
}

.qr-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 8rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.input {
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid var(--border-subtle);
  border-radius: 12rpx;
  padding: 0 20rpx;
  background: #fff;
}
