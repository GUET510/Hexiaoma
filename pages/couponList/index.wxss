.page {
  padding: 24rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.coupon-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.qr-box {
  display: flex;
  justify-content: center;
  padding: 12rpx 0;
}

.qr-canvas,
.qr-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
}
