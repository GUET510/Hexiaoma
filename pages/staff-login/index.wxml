<view class="page">
  <view class="section">
    <view class="section-title">员工登录</view>
    <view class="form-row">
      <input class="input" type="number" maxlength="11" placeholder="员工手机号" bindinput="onPhoneInput" />
      <input class="input" type="text" password="true" placeholder="登录密码" bindinput="onPwdInput" />
      <button class="primary-btn" loading="{{loading}}" bindtap="onSubmit">登录</button>
    </view>
    <view class="info-text">仅支持已登记员工手机号</view>
  </view>
</view>
