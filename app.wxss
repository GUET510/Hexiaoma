page {
  /* Black & Gold theme tokens */
  --color-bg-base: #050608;
  --color-bg-elevated: #101119;
  --color-bg-elevated-strong: #161823;
  --color-primary: #d9a85a;
  --color-primary-soft: #2b2214;
  --color-primary-gradient-from: #e6bf70;
  --color-primary-gradient-to: #c48c3a;
  --color-accent: #f5dfa0;
  --color-text-main: #f5f5f5;
  --color-text-secondary: #a4a6af;
  --color-text-disabled: #5b5d65;
  --color-text-inverse: #050608;
  --color-border-subtle: #262835;
  --color-border-strong: #3a3d4a;
  --color-border-gold: #d9a85a;
  --color-success: #35c18f;
  --color-success-bg: #16342a;
  --color-warning: #f2a45a;
  --color-warning-bg: #2e2115;
  --color-error: #f56c6c;
  --color-error-bg: #3a1718;
  --color-info: #4a90e2;
  --color-mask: rgba(0, 0, 0, 0.65);

  --font-title-xl: 48rpx;
  --font-title-lg: 40rpx;
  --font-title-md: 32rpx;
  --font-body: 28rpx;
  --font-caption: 24rpx;
  --font-mono: Menlo, SFMono-Regular, monospace;

  --radius-xs: 8rpx;
  --radius-sm: 16rpx;
  --radius-lg: 24rpx;
  --radius-pill: 999rpx;

  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  background: linear-gradient(to bottom, #050608, #0a0b10);
  color: var(--color-text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
}

.page-padding {
  padding: var(--space-lg);
}

.section {
  background: var(--color-bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.55);
  border: 1rpx solid var(--color-border-strong);
  margin-bottom: var(--space-lg);
}

.section-title {
  font-size: var(--font-title-md);
  font-weight: 600;
  margin-bottom: var(--space-md);
  color: var(--color-text-main);
  display: flex;
  align-items: center;
}

.badge {
  font-size: var(--font-caption);
  color: var(--color-primary);
  background: var(--color-primary-soft);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(217, 168, 90, 0.4);
  margin-left: var(--space-sm);
}

.primary-btn {
  background: linear-gradient(135deg, var(--color-primary-gradient-from), var(--color-primary-gradient-to));
  color: var(--color-text-inverse);
  border: none;
  border-radius: var(--radius-sm);
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  margin-top: 12rpx;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

.primary-btn:disabled {
  background: #2e2f38;
  color: var(--color-text-disabled);
  box-shadow: none;
}

.ghost-btn {
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border-subtle);
  border-radius: var(--radius-sm);
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  background: var(--color-bg-elevated);
}

.ghost-btn:active {
  background: #191b25;
}

.info-text {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.qr-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md);
  border: 1rpx dashed var(--color-border-subtle);
  border-radius: var(--radius-sm);
  min-height: 320rpx;
  background: #12131c;
}

.qr-tip {
  color: var(--color-text-secondary);
  font-size: 26rpx;
  text-align: center;
}

.qr-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240rpx, 1fr));
  gap: var(--space-md);
  width: 100%;
}

.qr-card {
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

.qr-visual {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-main);
}

.coupon-amount {
  font-size: 26rpx;
  color: var(--color-primary);
}

.qr-canvas {
  width: 240rpx;
  height: 240rpx;
}

.qr-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-gold);
  background: #0c0d13;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.input {
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid var(--color-border-subtle);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-md);
  background: #12131c;
  color: var(--color-text-main);
}

.input::placeholder {
  color: var(--color-text-disabled);
}

.section-divider {
  border: none;
  border-bottom: 1rpx solid var(--color-border-subtle);
  margin: var(--space-lg) 0;
}

.tag { 
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-xs);
  font-size: var(--font-caption);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}
