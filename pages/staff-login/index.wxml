<view class="page">
  <view class="section">
    <view class="section-title">员工手机号授权 <text class="badge">仅限员工</text></view>
    <view class="info-text">使用授权或手动手机号验证员工身份后进入核销工具。</view>
    <input class="input" type="number" placeholder="或直接输入手机号" bindinput="onManualPhoneInput" value="{{manualPhone}}" />
    <button class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">手机号授权登录</button>
    <button class="secondary-btn" bindtap="onManualSubmit">使用输入手机号登录</button>
    <view class="info-text" style="margin-top:12rpx;">需后台已添加员工资料</view>
  </view>
</view>
