.stat-bar {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  background: #f8fafc;
  border-radius: 12rpx;
  border: 2rpx solid var(--border-subtle);
  padding: 16rpx;
  gap: 16rpx;
}

.item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.label {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.value {
  font-size: 30rpx;
  font-weight: 700;
}
