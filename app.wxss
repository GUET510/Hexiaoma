page {
  background: #f6f7fb;
  color: #1f2f3d;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.badge {
  font-size: 20rpx;
  color: #39b54a;
  background: #e8f7ed;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.primary-btn {
  background: linear-gradient(90deg, #39b54a, #32a63f);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  margin-top: 12rpx;
}

.ghost-btn {
  color: #39b54a;
  border: 2rpx solid #39b54a;
  border-radius: 12rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  background: transparent;
}

.info-text {
  color: #6c7a89;
  font-size: 24rpx;
}

.qr-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 2rpx dashed #d0d8e0;
  border-radius: 12rpx;
  min-height: 280rpx;
  background: #fbfcff;
}

.qr-tip {
  color: #6c7a89;
  font-size: 26rpx;
  text-align: center;
}

.qr-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240rpx, 1fr));
  gap: 20rpx;
  width: 100%;
}

.qr-card {
  background: #f8fafc;
  border: 2rpx solid #e6ecf2;
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-amount {
  font-size: 24rpx;
  color: #2f5af5;
}

.qr-canvas {
  width: 240rpx;
  height: 240rpx;
}

.coupon-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #eef2f5;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.coupon-status {
  font-size: 24rpx;
  color: #6c7a89;
}

.coupon-status.used {
  color: #d14343;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f3f7ff;
  color: #2f5af5;
  font-size: 22rpx;
  margin-left: 12rpx;
}
