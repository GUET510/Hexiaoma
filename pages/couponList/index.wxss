.page {
  padding: var(--space-lg);
  background: linear-gradient(to bottom, #050608, #0a0b10);
  min-height: 100vh;
}

.actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.coupon-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.qr-box {
  display: flex;
  justify-content: center;
  padding: var(--space-sm) 0;
}

.qr-canvas,
.qr-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
}
