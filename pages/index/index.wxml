<view class="page">
  <view class="section">
    <view class="section-title">欢迎回来</view>
    <view class="info-text">已登录：{{phoneDisplay}}</view>
  </view>

  <view class="section">
    <view class="section-title">生成优惠券 <text class="badge">可选择券种</text></view>
    <view class="info-text">请选择一种优惠券类型生成二维码，可重复生成不同券。</view>
    <radio-group class="coupon-options" bindchange="onSelectCoupon">
      <block wx:for="{{couponOptions}}" wx:key="id">
        <label class="option-card" for="{{item.id}}">
          <radio id="{{item.id}}" value="{{item.id}}" checked="{{item.id === selectedCouponId}}" color="#39b54a" />
          <view class="option-content">
            <view class="option-title">{{item.title}}</view>
            <view class="info-text">{{item.tip}}</view>
          </view>
        </label>
      </block>
    </radio-group>
    <button class="primary-btn" bindtap="generateCoupon">生成所选优惠券二维码</button>
    <view class="qr-wrapper" style="margin-top:24rpx;" wx:if="qrReady">
      <view class="qr-grid">
        <block wx:for="{{activeCoupons}}" wx:key="id">
          <view class="qr-card">
            <view class="coupon-title">{{item.title}}</view>
            <view class="coupon-amount">核销码：{{item.code}}</view>
            <canvas class="qr-canvas" id="qr-{{item.id}}" type="2d" canvas-id="qr-{{item.id}}"></canvas>
            <view class="info-text">状态：{{item.statusLabel}}</view>
          </view>
        </block>
      </view>
    </view>
    <view wx:else class="qr-tip">二维码生成后会展示在这里</view>
  </view>

  <view class="section">
    <view class="section-title">优惠券列表 <text class="badge">本地示例</text></view>
    <view wx:if="coupons.length === 0" class="info-text">暂无优惠券，点击上方按钮生成。</view>
    <block wx:for="{{coupons}}" wx:key="id">
      <view class="coupon-card">
        <view>
          <view>{{item.title || '优惠券'}} · {{item.code}}</view>
          <view class="coupon-status {{item.status === 'used' ? 'used' : ''}}">{{item.status === 'used' ? '已核销' : '未核销'}}</view>
        </view>
        <view class="tag">{{item.createdAt}}</view>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-title">核销 <text class="badge">新界面</text></view>
    <view class="info-text">进入核销页面即可扫码或手动核销优惠券。</view>
    <button class="ghost-btn" bindtap="goVerify">前往核销</button>
  </view>
</view>
