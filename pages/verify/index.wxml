<view class="page">
  <view class="section">
    <view class="section-title">核销工具</view>
    <view class="form-row">
      <input class="input" placeholder="请输入或扫描核销码" bindinput="onInput" />
      <button class="primary-btn" bindtap="submitManual">手动核销</button>
      <button class="ghost-btn" bindtap="scanCode">扫码核销</button>
    </view>
    <view class="info-text">需要员工账号登录后使用核销功能</view>
  </view>
</view>
