.page {
  padding: 32rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  margin: 24rpx 0;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  background-color: #fff;
  font-size: 32rpx;
}

.secondary-btn {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #333;
  background-color: #f6f6f6;
  border-radius: 12rpx;
  border: 2rpx solid #e6e6e6;
}
