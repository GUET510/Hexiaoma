<view class="page">
  <view class="section">
    <view class="section-title">欢迎回来</view>
    <view class="info-text">已登录：{{phoneDisplay}}</view>
  </view>

  <view class="section">
    <view class="section-title">我的优惠券二维码</view>
    <view wx:if="qrReady" class="qr-wrapper" style="margin-top:12rpx;">
      <view class="qr-grid">
        <block wx:for="{{activeCoupons}}" wx:key="id">
          <view class="qr-card">
            <view class="coupon-title">{{item.title}}</view>
            <view class="coupon-amount">核销码：{{item.code}}</view>
            <view class="qr-visual">
              <image wx:if="{{item.qrImage}}" class="qr-img" mode="aspectFit" src="{{item.qrImage}}" />
              <canvas wx:else class="qr-canvas" id="qr-{{item.id}}" type="2d" canvas-id="qr-{{item.id}}"></canvas>
            </view>
            <view class="info-text">状态：{{item.statusLabel}}</view>
          </view>
        </block>
      </view>
    </view>
    <view wx:else class="qr-tip">暂时没有可用优惠券二维码</view>
  </view>

  <view class="section">
    <view class="section-title">优惠券列表</view>
    <block wx:if="{{coupons && coupons.length}}">
      <block wx:for="{{coupons}}" wx:key="id">
        <view class="coupon-card">
          <view>
            <view>{{item.title || '优惠券'}} · {{item.code}}</view>
            <view class="coupon-status {{item.status === 'used' ? 'used' : ''}}">{{item.status === 'used' ? '已核销' : '未核销'}}</view>
          </view>
          <view class="tag">有效期：{{item.validityText}}</view>
          <view class="tag">适用门店：{{item.storeScope || '全部门店'}}</view>
        </view>
      </block>
    </block>
    <view wx:else class="info-text">暂无优惠券，请联系工作人员发放。</view>
  </view>
</view>
