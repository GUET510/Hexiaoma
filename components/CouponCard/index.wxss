.card {
  background: radial-gradient(circle at top left, #2b2214 0, #101119 60%);
  border: 1rpx solid var(--color-border-gold);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.title {
  font-size: var(--font-title-md);
  font-weight: 700;
  color: var(--color-text-main);
}

.subtitle {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.badge {
  color: var(--color-primary);
  background: var(--color-primary-soft);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-caption);
  border: 1rpx solid rgba(217, 168, 90, 0.5);
}

.meta {
  display: flex;
  justify-content: space-between;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.code {
  background: #161823;
  border-radius: var(--radius-sm);
  padding: 12rpx 16rpx;
  border: 1rpx dashed var(--color-border-subtle);
}

.code-text {
  font-size: var(--font-body);
  letter-spacing: 2rpx;
  font-family: var(--font-mono);
  color: var(--color-text-main);
}
